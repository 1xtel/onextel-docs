{
  "openapi": "3.1.0",
  "info": {
    "title": "OneXtel SMS API (India)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.onexaura.com"
    }
  ],
  "paths": {
    "/send_sms": {
      "post": {
        "operationId": "send-sms-omni-send-sms-india",
        "summary": "Send SMS — India",
        "parameters": [
          {
            "name": "apikey",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sender": {
                          "type": "string"
                        },
                        "recipient": {
                          "type": "string"
                        },
                        "templateId": {
                          "type": "string"
                        },
                        "entityId": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "custRef1": {
                          "type": "string"
                        },
                        "custRef2": {
                          "type": "string"
                        },
                        "custRef3": {
                          "type": "string"
                        },
                        "custRef4": {
                          "type": "string"
                        },
                        "custRef5": {
                          "type": "string"
                        },
                        "messageBody": {
                          "type": "string"
                        },
                        "unicode": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "sender",
                        "recipient",
                        "messageBody",
                        "type"
                      ]
                    }
                  },
                  "validation": {
                    "type": "boolean"
                  },
                  "campaignName": {
                    "type": "string"
                  },
                  "prefix": {
                    "type": "string"
                  },
                  "urlShortener": {
                    "type": "object",
                    "properties": {
                      "flag": {
                        "type": "integer"
                      },
                      "urlDetails": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "longUrl": {
                              "type": "string"
                            },
                            "senderId": {
                              "type": "string"
                            },
                            "domain": {
                              "type": "string"
                            },
                            "track_user": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "example-request": {
                  "summary": "Example request",
                  "value": {
                    "sms": [
                      {
                        "sender": "ONEXTL",
                        "recipient": "919999999999",
                        "templateId": "YOUR_DLT_TEMPLATE_ID",
                        "entityId": "YOUR_DLT_ENTITY_ID",
                        "type": "SI",
                        "custRef1": "order-4821",
                        "custRef2": "",
                        "custRef3": "",
                        "custRef4": "",
                        "custRef5": "",
                        "messageBody": "Hi {#var#}, your secure code is {#var#}. Click here {#var#}",
                        "unicode": 0
                      }
                    ],
                    "validation": false,
                    "campaignName": "SpringPromo2026",
                    "prefix": "+91",
                    "urlShortener": {
                      "flag": 1,
                      "urlDetails": [
                        {
                          "longUrl": "https://example.com/offers/spring",
                          "senderId": "ONEXTL",
                          "domain": "links.example.com",
                          "track_user": 1
                        }
                      ]
                    }
                  }
                },
                "example-request-request-body": {
                  "summary": "Example request — Request body",
                  "value": {
                    "sms": [
                      {
                        "sender": "ONEXTL",
                        "recipient": "919999999999",
                        "type": "SI",
                        "messageBody": "This is a test sms.",
                        "templateId": "YOUR_DLT_TEMPLATE_ID",
                        "entityId": "YOUR_DLT_ENTITY_ID",
                        "unicode": 0,
                        "custRef1": {
                          "CustomReference1": "testSMS",
                          "CustomReference2": "123"
                        }
                      }
                    ],
                    "campaignName": "SMS2026",
                    "prefix": "+91",
                    "validation": false,
                    "urlShortener": {
                      "flag": 0,
                      "urlDetails": [
                        {
                          "longUrl": "",
                          "senderId": "",
                          "domain": "",
                          "track_user": 1
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
                "examples": {}
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Send SMS — India"
        ]
      }
    }
  }
}
