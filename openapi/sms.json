{
  "openapi": "3.1.0",
  "info": {
    "title": "OneXtel SMS API (India)",
    "version": "1.0.0",
    "description": "Send DLT-compliant SMS to Indian numbers.\n\nGenerated from the OneXtel API reference by scripts/build-openapi.py."
  },
  "servers": [
    {
      "url": "https://api.onexaura.com",
      "description": "Production"
    }
  ],
  "paths": {
    "/send_sms": {
      "post": {
        "operationId": "send-sms-omni-send-sms-india",
        "summary": "Send SMS — India",
        "description": "Full reference: https://onextel-09023014.mintlify.site/api-reference/sms/send-sms-omni",
        "parameters": [
          {
            "name": "apikey",
            "in": "header",
            "required": true,
            "description": "API key issued by OneXtel.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sender": {
                          "type": "string",
                          "description": "Sender ID. Must be DLT-approved — see DLT registration."
                        },
                        "recipient": {
                          "type": "string",
                          "description": "Recipient mobile number."
                        },
                        "templateId": {
                          "type": "string",
                          "description": "DLT-approved template ID."
                        },
                        "entityId": {
                          "type": "string",
                          "description": "DLT entity ID."
                        },
                        "type": {
                          "type": "string",
                          "description": "Message type: `SI`, `OTP`, or `SE`. Case-sensitive."
                        },
                        "custRef1": {
                          "type": "string"
                        },
                        "custRef2": {
                          "type": "string"
                        },
                        "custRef3": {
                          "type": "string"
                        },
                        "custRef4": {
                          "type": "string"
                        },
                        "custRef5": {
                          "type": "string"
                        },
                        "messageBody": {
                          "type": "string",
                          "description": "Content of the SMS."
                        },
                        "unicode": {
                          "type": "integer",
                          "description": "`1` for a Unicode message, `0` for normal text. **Required when sending Unicode.**"
                        }
                      },
                      "required": [
                        "sender",
                        "recipient",
                        "messageBody",
                        "type"
                      ]
                    }
                  },
                  "validation": {
                    "type": "boolean",
                    "description": "`true` rejects invalid requests outright; `false` processes them anyway."
                  },
                  "campaignName": {
                    "type": "string",
                    "description": "Identifier used to group and track messages as a campaign. Set it if you want the send to be filterable in reports."
                  },
                  "prefix": {
                    "type": "string",
                    "description": "Country code applied to recipient numbers — for example `+91`."
                  },
                  "urlShortener": {
                    "type": "object",
                    "properties": {
                      "flag": {
                        "type": "integer",
                        "description": "`1` enables shortening, `0` disables it. Required if short-URL conversion is needed."
                      },
                      "urlDetails": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "longUrl": {
                              "type": "string",
                              "description": "The original URL to shorten. Required when `flag` is `1`."
                            },
                            "senderId": {
                              "type": "string",
                              "description": "Sender ID associated with the shortened URL. Required when `flag` is `1`."
                            },
                            "domain": {
                              "type": "string",
                              "description": "Custom domain, if one is configured for your account. Required when `flag` is `1`."
                            },
                            "track_user": {
                              "type": "integer",
                              "description": "`1` enables click tracking, `0` disables it. Required if location tracking is needed."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "example-request": {
                  "summary": "Example request",
                  "value": {
                    "sms": [
                      {
                        "sender": "ONEXTL",
                        "recipient": "919999999999",
                        "templateId": "YOUR_DLT_TEMPLATE_ID",
                        "entityId": "YOUR_DLT_ENTITY_ID",
                        "type": "SI",
                        "custRef1": "order-4821",
                        "custRef2": "",
                        "custRef3": "",
                        "custRef4": "",
                        "custRef5": "",
                        "messageBody": "Hi {#var#}, your secure code is {#var#}. Click here {#var#}",
                        "unicode": 0
                      }
                    ],
                    "validation": false,
                    "campaignName": "SpringPromo2026",
                    "prefix": "+91",
                    "urlShortener": {
                      "flag": 1,
                      "urlDetails": [
                        {
                          "longUrl": "https://example.com/offers/spring",
                          "senderId": "ONEXTL",
                          "domain": "links.example.com",
                          "track_user": 1
                        }
                      ]
                    }
                  }
                },
                "example-request-request-body": {
                  "summary": "Example request — Request body",
                  "value": {
                    "sms": [
                      {
                        "sender": "ONEXTL",
                        "recipient": "919999999999",
                        "type": "SI",
                        "messageBody": "This is a test sms.",
                        "templateId": "YOUR_DLT_TEMPLATE_ID",
                        "entityId": "YOUR_DLT_ENTITY_ID",
                        "unicode": 0,
                        "custRef1": {
                          "CustomReference1": "testSMS",
                          "CustomReference2": "123"
                        }
                      }
                    ],
                    "campaignName": "SMS2026",
                    "prefix": "+91",
                    "validation": false,
                    "urlShortener": {
                      "flag": 0,
                      "urlDetails": [
                        {
                          "longUrl": "",
                          "senderId": "",
                          "domain": "",
                          "track_user": 1
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {}
              }
            }
          }
        },
        "tags": [
          "Send Sms Omni"
        ]
      },
      "get": {
        "operationId": "send-sms-omni-send-sms-india-get",
        "summary": "Send SMS — India (GET)",
        "description": "Full reference: https://onextel-09023014.mintlify.site/api-reference/sms/send-sms-omni#send-via-get",
        "parameters": [
          {
            "name": "apikey",
            "in": "query",
            "required": true,
            "description": "Your OneXtel API key.",
            "schema": { "type": "string" }
          },
          {
            "name": "sender",
            "in": "query",
            "required": true,
            "description": "Sender ID. Must be DLT-approved.",
            "schema": { "type": "string" }
          },
          {
            "name": "recipient",
            "in": "query",
            "required": true,
            "description": "Recipient mobile number. Pass a comma-separated list for one-to-many.",
            "schema": { "type": "string" }
          },
          {
            "name": "messageBody",
            "in": "query",
            "required": true,
            "description": "Content of the SMS.",
            "schema": { "type": "string" }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Message type: SI, OTP, or SE. Case-sensitive.",
            "schema": { "type": "string" }
          },
          {
            "name": "templateId",
            "in": "query",
            "required": false,
            "description": "DLT-approved template ID.",
            "schema": { "type": "string" }
          },
          {
            "name": "entityId",
            "in": "query",
            "required": false,
            "description": "DLT entity ID.",
            "schema": { "type": "string" }
          },
          {
            "name": "campaignName",
            "in": "query",
            "required": false,
            "description": "Identifier used to group and track messages as a campaign.",
            "schema": { "type": "string" }
          },
          {
            "name": "urlflag",
            "in": "query",
            "required": false,
            "description": "The query-string equivalent of urlShortener.flag.",
            "schema": { "type": "integer" }
          },
          {
            "name": "custref1",
            "in": "query",
            "required": false,
            "description": "Custom reference 1.",
            "schema": { "type": "string" }
          },
          {
            "name": "custref2",
            "in": "query",
            "required": false,
            "description": "Custom reference 2.",
            "schema": { "type": "string" }
          },
          {
            "name": "custref3",
            "in": "query",
            "required": false,
            "description": "Custom reference 3.",
            "schema": { "type": "string" }
          },
          {
            "name": "custref4",
            "in": "query",
            "required": false,
            "description": "Custom reference 4.",
            "schema": { "type": "string" }
          },
          {
            "name": "custref5",
            "in": "query",
            "required": false,
            "description": "Custom reference 5.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "requestId": { "type": "string" },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string" },
                          "recipient": { "type": "string" },
                          "messageId": { "type": "string" },
                          "description": { "type": "string" }
                        }
                      }
                    },
                    "campaignName": { "type": "string" }
                  }
                },
                "examples": {
                  "response-success": {
                    "summary": "Accepted",
                    "value": {
                      "status": "SUCCESS",
                      "requestId": "3LEHfngZVkPpKMuOLeNg8a9svwE",
                      "messages": [
                        {
                          "status": "SENT",
                          "recipient": "919999999999",
                          "messageId": "3LEHfn7qH426KqtcrpkEMn6vigq",
                          "description": "Message submitted successfully"
                        }
                      ],
                      "campaignName": "SMS2026"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Send Sms Omni"
        ]
      }
    },
    "/surl": {
      "get": {
        "operationId": "sms-url-shortener",
        "summary": "Standalone URL Shortener",
        "description": "Full reference: https://onextel-09023014.mintlify.site/api-reference/sms/url-shortener",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "The long URL to shorten.",
            "schema": { "type": "string" }
          },
          {
            "name": "apikey",
            "in": "query",
            "required": true,
            "description": "Your OneXtel API key. Can also be passed as a header.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "short_url": { "type": "string" }
                  }
                },
                "examples": {
                  "response-success": {
                    "summary": "Accepted",
                    "value": { "short_url": "onexaura.com/shu/00BLlM" }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "URL Shortener"
        ]
      }
    },
    "/get_status": {
      "get": {
        "operationId": "sms-get-status-get",
        "summary": "Pull Message Status (GET)",
        "description": "Full reference: https://onextel-09023014.mintlify.site/api-reference/sms/get-status",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "description": "Your OneXtel API key.",
            "schema": { "type": "string" }
          },
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "description": "One message UUID, or several separated by commas.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "UUId": { "type": "string" },
                    "statusCode": { "type": "string" },
                    "description": { "type": "string" },
                    "deliveryStatus": { "type": "string" },
                    "deliveredtimestamp": { "type": "string" }
                  }
                },
                "examples": {
                  "response-success": {
                    "summary": "Accepted",
                    "value": {
                      "UUId": "3KaaATbUD5rSac7HTgm98ihFRUw",
                      "statusCode": "000",
                      "description": "Message delivered successfully",
                      "deliveryStatus": "DELIVERED",
                      "deliveredtimestamp": "2026-10-12 15:09:49"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Get Status"
        ]
      },
      "post": {
