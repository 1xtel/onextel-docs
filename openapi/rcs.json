              "type": "string"
            },
            "example": "promotional"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Opt In/ Opt Out"
        ],
        "summary": "Add Opt Out",
        "operationId": "rcs-add-opt-out-post",
        "parameters": [
          {
            "name": "apikey",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "{{apikey}}"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "numbers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sender": {
                    "type": "string"
                  },
                  "message_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "examples": {
                "add-opt-out": {
                  "summary": "Add Opt Out",
                  "value": {
                    "numbers": [
                      "recipient1",
                      "recipient2"
                    ],
                    "sender": "{{rcssender}}",
                    "message_types": [
                      "promotional",
                      "transactional"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
