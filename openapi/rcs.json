        "summary": "Remove Opt Out",
        "operationId": "rcs-remove-opt-out-delete",
        "parameters": [
          {
            "name": "apikey",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "{{apikey}}"
          },
          {
            "name": "number",
            "in": "query",
            "schema": {
              "type": "string"
