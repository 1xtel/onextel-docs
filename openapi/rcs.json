    "/rcs/templates": {
      "post": {
        "operationId": "templates-create-template",
        "summary": "Create Template",
        "parameters": [
          {
            "name": "apikey",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "string"
                  },
                  "sender_profile_name": {
                    "type": "string"
                  },
                  "update_by": {
                    "type": "string"
                  },
                  "message_type": {
                    "type": "string"
                  },
                  "multimedia_files": {
                    "type": "string",
                    "format": "binary"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "suggestions": {
                    "type": "string"
                  },
                  "suggestionType": {
                    "type": "string"
                  },
                  "displayText": {
                    "type": "string"
                  },
                  "postback": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "phoneNumber": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "latitude": {
                    "type": "string"
                  },
                  "longitude": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "startTime": {
                    "type": "string"
                  },
                  "endTime": {
                    "type": "string"
                  },
                  "timeZone": {
                    "type": "string"
                  },
                  "textMessageContent": {
                    "type": "string"
                  },
                  "documentUrl": {
                    "type": "string"
                  },
                  "messageOrder": {
                    "type": "string"
                  },
                  "orientation": {
                    "type": "string"
                  },
                  "height": {
                    "type": "string"
                  },
                  "alignment": {
                    "type": "string"
                  },
                  "standAlone": {
                    "type": "string"
                  },
                  "mediaUrl": {
                    "type": "string"
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "cardTitle": {
                    "type": "string"
                  },
                  "cardDescription": {
                    "type": "string"
                  },
                  "width": {
                    "type": "string"
                  },
                  "carouselList": {
                    "type": "string"
                  },
                  "templateState": {
                    "type": "string"
                  }
                },
                "required": [
                  "data",
                  "sender_profile_name",
                  "update_by",
                  "message_type",
                  "name",
                  "type",
                  "suggestionType",
                  "displayText",
                  "postback",
                  "name",
                  "type",
                  "textMessageContent",
                  "type",
                  "documentUrl",
                  "messageOrder",
                  "textMessageContent",
                  "name",
                  "type",
                  "orientation",
                  "height",
                  "alignment",
                  "standAlone",
                  "mediaUrl",
                  "cardTitle",
                  "cardDescription",
                  "name",
                  "type",
                  "width",
                  "height",
                  "carouselList",
                  "mediaUrl",
                  "cardTitle",
                  "cardDescription"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
