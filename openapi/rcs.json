{
  "openapi": "3.1.0",
  "info": {
    "title": "OneXtel RCS API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.onexaura.com"
    }
  ],
  "paths": {
    "/oapi/templates/fetch": {
      "post": {
        "tags": [
          "Template"
        ],
        "summary": "Fetch Template",
        "operationId": "rcs-fetch-template-post",
        "parameters": [
          {
            "name": "apiKey",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "{{apikey}}"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "channel": {
                    "type": "string"
                  },
                  "senderProfile": {
                    "type": "string"
                  },
                  "messageType": {
                    "type": "string"
                  },
                  "pageNo": {
                    "type": "integer"
                  },
                  "limit": {
                    "type": "integer"
                  }
                }
              },
              "examples": {
                "fetch-template": {
                  "summary": "Fetch Template",
                  "value": {
                    "channel": "RCS",
                    "senderProfile": "{{rcssender}}",
                    "messageType": "Promotional",
                    "pageNo": 1,
                    "limit": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/oapi/send_sms": {
      "post": {
        "tags": [
          "Template Message"
        ],
        "summary": "Template Message / Non Template Message",
        "operationId": "rcs-template-message-non-template-message-post",
        "parameters": [
          {
            "name": "apikey",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "{{apikey}}"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rcs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sender": {
                          "type": "string"
                        },
                        "recipient": {
                          "type": "string"
                        },
                        "messageType": {
                          "type": "string"
                        },
                        "contentMessage": {
                          "type": "object",
                          "properties": {
                            "templateMessage": {
                              "type": "object",
                              "properties": {
                                "templateCode": {
                                  "type": "string"
                                }
                              }
                            },
                            "text": {
                              "type": "string"
                            },
                            "richCard": {
                              "type": "object",
                              "properties": {
                                "standaloneCard": {
                                  "type": "object",
                                  "properties": {
                                    "cardOrientation": {
                                      "type": "string"
                                    },
                                    "cardContent": {
                                      "type": "object",
                                      "properties": {
                                        "title": {
                                          "type": "string"
                                        },
                                        "media": {
                                          "type": "object",
                                          "properties": {
                                            "contentInfo": {
                                              "type": "object",
                                              "properties": {
                                                "fileUrl": {
                                                  "type": "string"
                                                },
                                                "thumbnailUrl": {
                                                  "type": "string"
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "send-template-message": {
                  "summary": "Send Template Message",
                  "value": {
                    "rcs": [
                      {
                        "sender": "{{rcssender}}",
                        "recipient": "{{recipient1}}",
                        "messageType": "xx",
                        "contentMessage": {
                          "templateMessage": {
                            "templateCode": "xx"
                          }
                        }
                      }
                    ]
                  }
                },
                "plain-text": {
                  "summary": "Plain Text",
                  "value": {
                    "rcs": [
                      {
                        "sender": "{{rcssender}}",
                        "recipient": "{{recipient1}}",
                        "messageType": "xx",
                        "contentMessage": {
                          "text": "xx"
                        }
                      }
                    ]
                  }
                },
                "richcard-standalone": {
                  "summary": "RichCard Standalone",
                  "value": {
                    "rcs": [
                      {
                        "sender": "{{rcssender}}",
                        "recipient": "{{recipient1}}",
                        "messageType": "Promotional",
                        "contentMessage": {
                          "richCard": {
                            "standaloneCard": {
                              "cardOrientation": "VERTICAL",
                              "cardContent": {
                                "title": "xx",
                                "media": {
                                  "contentInfo": {
                                    "fileUrl": "xx",
                                    "thumbnailUrl": ""
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "richcard-carousel": {
                  "summary": "RichCard Carousel",
                  "value": {
                    "rcs": [
                      {
                        "sender": "{{rcssender}}",
                        "recipient": "{{recipient1}}",
                        "messageType": "Promotional",
                        "contentMessage": {
                          "richCard": {
                            "standaloneCard": {
                              "cardOrientation": "VERTICAL",
                              "cardContent": {
                                "title": "xx",
                                "media": {
                                  "contentInfo": {
                                    "fileUrl": "{{imageUrl}}",
                                    "thumbnailUrl": ""
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rcs/mediaupload": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Media Upload",
        "operationId": "rcs-media-upload-post",
        "parameters": [
          {
            "name": "apikey",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "{{apikey}}"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "senderProfileName": {
                    "type": "string"
                  },
                  "message_type": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "examples": {
                "media-upload": {
                  "summary": "Media Upload",
                  "value": {
                    "senderProfileName": "{{rcssender}}",
                    "message_type": "xx"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/opt/out/rcs": {
      "get": {
        "tags": [
          "Opt In/ Opt Out"
        ],
        "summary": "Get Opt Out",
        "operationId": "rcs-get-opt-out-get",
        "parameters": [
