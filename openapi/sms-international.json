                        },
                        "custref2": {
                          "type": "string"
                        },
                        "custref3": {
                          "type": "string"
                        },
                        "custref4": {
                          "type": "string"
                        },
                        "custref5": {
                          "type": "string"
                        }
                      }
                    },
                    "description": "A list containing one or more SMS message objects to be sent. **Maximum 2,500 objects per request.**"
                  },
                  "from": {
                    "type": "string",
                    "description": "Sender ID or name that appears as the message originator. Accepts alphanumeric or numeric values — OneXtel applies no validation to this field. See Sender IDs before you choose one."
                  },
                  "to": {
                    "type": "string",
                    "description": "Recipient's mobile number including country code (e.g., `918872725225`)."
                  },
                  "body": {
                    "type": "string",
                    "description": "The text content of the SMS message."
                  },
                  "clientsmsid": {
                    "type": "string",
                    "description": "Client-side unique identifier for tracking the message. Echoed back as `CLIENTMSID` on the delivery receipt."
                  },
                  "custref1": {
                    "type": "string",
                    "description": "Custom reference value. Echoed back unchanged on both the submission response and the delivery receipt. See Reference IDs."
                  },
                  "custref2": {
                    "type": "string",
                    "description": "Second custom reference value."
                  },
                  "custref3": {
                    "type": "string",
                    "description": "Third custom reference value."
                  },
                  "custref4": {
                    "type": "string",
                    "description": "Fourth custom reference value."
                  },
                  "custref5": {
                    "type": "string",
                    "description": "Fifth custom reference value."
                  }
                },
                "required": [
                  "key",
                  "from",
                  "to",
                  "body"
                ]
              },
              "examples": {
